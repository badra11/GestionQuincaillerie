<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="produit-root" spacing="10.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bad.gestionquincaillerie.controllers.ClientController">

    <stylesheets>
        <URL value="@../styles/client.css"/>
    </stylesheets>

    <padding>
        <Insets top="20.0" bottom="20.0" left="20.0" right="20.0"/>
    </padding>

    <Label text="Gestion des Clients" styleClass="page-titre"/>

    <VBox styleClass="form-card" spacing="12.0">
        <Label text="Ajouter un client" styleClass="form-titre" maxWidth="Infinity"/>

        <GridPane hgap="15.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints minWidth="110.0"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0"/>
                <ColumnConstraints minWidth="110.0"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0"/>
            </columnConstraints>

            <Label text="Type de client" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbTypeClient" promptText="Choisir un type" maxWidth="Infinity"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Nom" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="txtNom" promptText="Ex: Amadou Traoré"
                       GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Email" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmail" promptText="Ex: client@email.com"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Téléphone" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <VBox spacing="4.0" GridPane.rowIndex="1" GridPane.columnIndex="3">
                <TextField fx:id="txtTelephone" promptText="Ex: 76 00 00 00"/>
                <Label fx:id="lblCreance" styleClass="creance-info"/>
            </VBox>

            <Label text="Adresse" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtAdresse" promptText="Ex: Bamako, Mali"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            
            <Label text="Adresse" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            
        </GridPane>

        <HBox spacing="10.0">
            <Button fx:id="btnAjouter" styleClass="btn-ajouter" onAction="#ajouterClient">
                <graphic>
                    <FontIcon iconLiteral="fas-plus" iconSize="13" styleClass="btn-icon"/>
                </graphic>
                <text>Ajouter le client</text>
            </Button>
            <Button fx:id="btnAnnuler" styleClass="btn-annuler" onAction="#annulerClient" visible="false" managed="false">
                <graphic>
                    <FontIcon iconLiteral="fas-times" iconSize="13" styleClass="btn-icon-annuler"/>
                </graphic>
                <text>Annuler</text>
            </Button>
            <Button fx:id="btnSupprimer" styleClass="btn-supprimer" onAction="#supprimerClient" visible="false" managed="false">
                <graphic>
                    <FontIcon iconLiteral="fas-trash" iconSize="13" styleClass="btn-icon-supprimer"/>
                </graphic>
                <text>Supprimer</text>
            </Button>
            <Button fx:id="btnHistorique" styleClass="btn-stocker" onAction="#voirHistorique" visible="false" managed="false">
                <graphic>
                    <FontIcon iconLiteral="fas-history" iconSize="13" styleClass="btn-icon"/>
                </graphic>
                <text>Historique d'achats</text>
            </Button>
        </HBox>
        <Label fx:id="lblMessage" styleClass="message-label"/>
    </VBox>

    <Label text="Liste des clients" styleClass="liste-titre"/>
    <TableView fx:id="tableClients" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="colTypeClient" text="Type" prefWidth="110.0"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="180.0"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180.0"/>
            <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="120.0"/>
            <TableColumn fx:id="colAdresse" text="Adresse" prefWidth="180.0"/>
            <TableColumn fx:id="colCreance" text="Créance" prefWidth="90.0"/>
        </columns>
    </TableView>

    

</VBox>
