<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="produit-root" spacing="10.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bad.gestionquincaillerie.controllers.JournalActiviteController">

    <stylesheets>
        <URL value="@../styles/journalActivite.css"/>
    </stylesheets>

    <padding>
        <Insets top="20.0" bottom="20.0" left="20.0" right="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="Journal d'activité" styleClass="page-titre"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnActualiser" styleClass="btn-ajouter" onAction="#actualiser">
            <graphic><FontIcon iconLiteral="fas-sync" iconSize="13" styleClass="btn-icon"/></graphic>
            <text>Actualiser</text>
        </Button>
    </HBox>

    <Label text="Les 500 dernières actions enregistrées" styleClass="liste-titre"/>

    <TableView fx:id="tableJournal" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="160.0"/>
            <TableColumn fx:id="colEmploye" text="Employé" prefWidth="180.0"/>
            <TableColumn fx:id="colAction" text="Action" prefWidth="400.0"/>
        </columns>
    </TableView>

</VBox>
